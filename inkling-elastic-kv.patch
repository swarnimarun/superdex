+#include "inkling-elastic-kv.h"
+
+#include <stdexcept>
+#ifdef INKLING_CUDA_VMM_KV
+#    include "ggml-backend-impl.h"
+#    include "ggml-cpp.h"
+
+#    include <cuda.h>
+#    include <dlfcn.h>
+
+#    include <algorithm>
+#    include <cstdio>
+#    include <cstring>
+#    include <memory>
+#    include <stdexcept>
+#    include <vector>
+
+namespace {
+// Resolve the driver only on the VMM path. Conventional CUDA and CPU builds retain
+// their normal loader behavior even on a host without libcuda installed.
+#    define IK_STRING_1(x) #x
+#    define IK_STRING(x)   IK_STRING_1(x)
+#    define IK_CUDA_SYMBOLS(X)                                        \
+        X(CtxPopCurrent, cuCtxPopCurrent)                             \
+        X(CtxPushCurrent, cuCtxPushCurrent)                           \
+        X(CtxSynchronize, cuCtxSynchronize)                           \
+        X(DeviceGet, cuDeviceGet)                                     \
+        X(DeviceGetAttribute, cuDeviceGetAttribute)                   \
+        X(DevicePrimaryCtxRelease, cuDevicePrimaryCtxRelease)         \
+        X(DevicePrimaryCtxRetain, cuDevicePrimaryCtxRetain)           \
+        X(GetErrorString, cuGetErrorString)                           \
+        X(Init, cuInit)                                               \
+        X(MemAddressFree, cuMemAddressFree)                           \
+        X(MemAddressReserve, cuMemAddressReserve)                     \
+        X(MemCreate, cuMemCreate)                                     \
+        X(MemGetAllocationGranularity, cuMemGetAllocationGranularity) \
+        X(MemMap, cuMemMap)                                           \
+        X(MemRelease, cuMemRelease)                                   \
+        X(MemSetAccess, cuMemSetAccess)                               \
+        X(MemUnmap, cuMemUnmap)                                       \
+        X(MemcpyDtoH, cuMemcpyDtoH)                                   \
+        X(MemcpyHtoD, cuMemcpyHtoD)                                   \
+        X(MemsetD8, cuMemsetD8)
+
+struct inkling_driver_api {
+    bool ready = false;
+#    define IK_FIELD(field, symbol) decltype(&::symbol) field = nullptr;
+    IK_CUDA_SYMBOLS(IK_FIELD)
+#    undef IK_FIELD
+
+    inkling_driver_api() {
+        void * library = dlopen("libcuda.so.1", RTLD_NOW | RTLD_LOCAL);
+        if (!library) {
+            return;
+        }
+#    define IK_LOAD(field, symbol)                                                    \
+        field = reinterpret_cast<decltype(field)>(dlsym(library, IK_STRING(symbol))); \
+        if (!field)                                                                   \
+            return;
+        IK_CUDA_SYMBOLS(IK_LOAD)
+#    undef IK_LOAD
+        ready = true;
+    }
+};
+
+inkling_driver_api & cuda_driver() {
+    static inkling_driver_api driver;
+    return driver;
+}
+
+#    undef IK_CUDA_SYMBOLS
+#    undef IK_STRING
+#    undef IK_STRING_1
+
+void vmm_check(CUresult r, const char * call) {
+    if (r != CUDA_SUCCESS) {
+        const char * msg = nullptr;
+        cuda_driver().GetErrorString(r, &msg);
+        throw std::runtime_error(std::string("Inkling elastic KV: ") + call + ": " + (msg ? msg : "CUDA driver error"));
+    }
+}
+
+#    define IK_CU(x) vmm_check((x), #x)
+
+struct scoped_cuda_context {
+    explicit scoped_cuda_context(CUcontext ctx) { IK_CU(cuda_driver().CtxPushCurrent(ctx)); }
+
+    ~scoped_cuda_context() {
+        CUcontext prev;
+        if (cuda_driver().CtxPopCurrent(&prev) != CUDA_SUCCESS) {
+            std::terminate();
+        }
+    }
+};
+
+// Only cuMemCreate reporting exhausted physical memory warrants evicting an expert bank.
+struct vmm_physical_oom : std::runtime_error {
+    vmm_physical_oom() : std::runtime_error("Inkling elastic KV: cuMemCreate: out of memory") {}
+};
+
+struct tensor_pages {
+    ggml_tensor * t;
+    size_t        offset, max, live;
+};
+
+struct kv_mapping {
+    llama_kv_cache *          owner;
+    CUdevice                  device = 0;
+    CUcontext                 ctx    = nullptr;
+    CUdeviceptr               va     = 0;
+    size_t                    page = 0, chunk = 0, reserved = 0, live = 0;
+    uint32_t                  cells;
+    CUmemAllocationProp       prop{};
+    CUmemAccessDesc           access{};
+    std::vector<tensor_pages> tensors;
+    const void *              reclaim_owner = nullptr;
+    std::function<void()>     reclaim;
+
+    kv_mapping(llama_kv_cache * owner, uint32_t cells) : owner(owner), cells(cells) {}
+
+    size_t round(size_t n) const { return ((n + page - 1) / page) * page; }
+
+    bool setup(ggml_context * gg) {
+        if (!cuda_driver().ready) {
+            throw std::runtime_error("Inkling elastic KV cannot load the CUDA driver VMM entry points");
+        }
+        IK_CU(cuda_driver().Init(0));
+        IK_CU(cuda_driver().DeviceGet(&device, 0));
+        int supported = 0;
+        IK_CU(cuda_driver().DeviceGetAttribute(&supported, CU_DEVICE_ATTRIBUTE_VIRTUAL_MEMORY_MANAGEMENT_SUPPORTED,
+                                               device));
+        if (!supported) {
+            throw std::runtime_error("Inkling elastic KV: CUDA0 lacks VMM");
+        }
+        IK_CU(cuda_driver().DevicePrimaryCtxRetain(&ctx, device));
+        scoped_cuda_context current(ctx);
+        prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+        prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        prop.location.id   = device;
+        access.location    = prop.location;
+        access.flags       = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        IK_CU(cuda_driver().MemGetAllocationGranularity(&page, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM));
+        chunk = page;
+        if (const char * text = std::getenv("INKLING_ELASTIC_KV_CHUNK_MIB")) {
+            char *     end   = nullptr;
+            const long value = std::strtol(text, &end, 10);
+            if (end == text || *end || value < 0 || value > 32) {
+                throw std::runtime_error("INKLING_ELASTIC_KV_CHUNK_MIB must be an integer from 0 to 32");
+            }
+            if (value) {
+                chunk = round(size_t(value) << 20);
+            }
+        }
+        for (ggml_tensor * t = ggml_get_first_tensor(gg); t; t = ggml_get_next_tensor(gg, t)) {
+            if (t->view_src) {
+                continue;
+            }
+            if (t->type != GGML_TYPE_F16 || t->ne[1] != cells || t->ne[2] != 1 || t->ne[3] != 1 ||
+                !ggml_is_contiguous(t)) {
+                throw std::runtime_error("Inkling elastic KV: unexpected global FP16 tensor layout");
+            }
+            size_t len = round(ggml_nbytes(t));
+            tensors.push_back({ t, reserved, len, 0 });
+            reserved += len;
+        }
+        if (tensors.empty() || !reserved || !inkling_cuda_budget_available()) {
+            throw std::runtime_error("Inkling elastic KV requires a nonzero shared CUDA buffer budget");
+        }
+        CUdeviceptr    address = 0;
+        const CUresult rc      = cuda_driver().MemAddressReserve(&address, reserved, 0, 0, 0);
+        const char *   mode    = std::getenv("INKLING_ELASTIC_KV");
+        if (rc != CUDA_SUCCESS && mode && std::strcmp(mode, "auto") == 0) {
+            const char * message = nullptr;
+            cuda_driver().GetErrorString(rc, &message);
+            std::fprintf(stderr,
+                         "Inkling elastic KV: using conventional KV after cuMemAddressReserve failed (%d: %s)\n",
+                         int(rc), message ? message : "CUDA driver error");
+            return false;
+        }
+        vmm_check(rc, "cuMemAddressReserve");
+        va = address;
+        return true;
+    }
+
+    ~kv_mapping() {
+        if (ctx) {
+            {
+                scoped_cuda_context current(ctx);
+                if (va) {
+                    IK_CU(cuda_driver().CtxSynchronize());
+                    for (auto & t : tensors) {
+                        unmap_down(t, 0);
+                    }
+                    IK_CU(cuda_driver().MemAddressFree(va, reserved));
+                }
+            }
+            IK_CU(cuda_driver().DevicePrimaryCtxRelease(device));
+        }
+    }
+
+    void unmap_down(tensor_pages & t, size_t bytes) {
+        while (t.live > bytes) {
+            const size_t prev          = t.live <= page ? 0 : std::max(page, ((t.live - 1) / chunk) * chunk);
+            const size_t bytes_removed = t.live - prev;
+            IK_CU(cuda_driver().MemUnmap(va + t.offset + prev, bytes_removed));
+            t.live = prev;
+            live -= bytes_removed;
+            inkling_cuda_release_external(bytes_removed);
+        }
+    }
+
+    void map_one(CUdeviceptr addr, size_t bytes) {
+        CUmemGenericAllocationHandle h;
+        const CUresult               created = cuda_driver().MemCreate(&h, bytes, &prop, 0);
+        if (created == CUDA_ERROR_OUT_OF_MEMORY) {
+            throw vmm_physical_oom();
+        }
+        vmm_check(created, "cuMemCreate");
+        CUresult       mapped   = cuda_driver().MemMap(addr, bytes, 0, h, 0);
+        const CUresult released = cuda_driver().MemRelease(h);
+        if (mapped != CUDA_SUCCESS) {
+            IK_CU(released);
+            IK_CU(mapped);
+        }
+        if (released != CUDA_SUCCESS) {
+            IK_CU(cuda_driver().MemUnmap(addr, bytes));
+            IK_CU(cuda_driver().MemRelease(h));
+            IK_CU(released);
+        }
+        try {
+            IK_CU(cuda_driver().MemSetAccess(addr, bytes, &access, 1));
+            IK_CU(cuda_driver().MemsetD8(addr, 0, bytes));
+        } catch (...) {
+            IK_CU(cuda_driver().MemUnmap(addr, bytes));
+            throw;
+        }
+    }
+
+    void resize(uint32_t rows, bool shrink) {
+        if (rows > cells) {
+            throw std::runtime_error("Inkling elastic KV row exceeds virtual reservation");
+        }
+        size_t add = 0, drop = 0;
+        auto   goal = [&](const tensor_pages & t) {
+            const size_t required = size_t(rows) * t.t->nb[1];
+            // One minimum page for short contexts; the last physical extent is
+            // clipped to this tensor's native minimum-page-aligned capacity.
+            if (required <= page) {
+                return round(required);
+            }
+            return std::min(t.max, ((required + chunk - 1) / chunk) * chunk);
+        };
+        for (auto & t : tensors) {
+            size_t target = goal(t);
+            if (target > t.live) {
+                add += target - t.live;
+            } else if (shrink) {
+                drop += t.live - target;
+            }
+        }
+        if (!add && !drop) {
+            return;
+        }
+        scoped_cuda_context current(ctx);
+        std::vector<size_t> old;
+        for (auto & t : tensors) {
+            old.push_back(t.live);
+        }
+        // Called from actual memory placement, before graph construction, or from a synchronized state operation.
+        bool reclaimed    = false;
+        auto reclaim_once = [&] {
+            if (reclaimed || !reclaim) {
+                return false;
+            }
+            reclaimed     = true;
+            auto callback = reclaim;  // the callback unregisters itself
+            callback();
+            return true;
+        };
+        for (;;) {
+            if (add && !inkling_cuda_charge_external(add)) {
+                if (reclaim_once()) {
+                    continue;
+                }
+                throw std::runtime_error("Inkling elastic KV growth exceeds the CUDA buffer limit");
+            }
+            size_t consumed = 0;
+            auto   rollback = [&] {
+                // New extents can still have zero fills outstanding on the default stream.
+                // Complete them before unmapping. Always release the unconsumed charge.
+                const CUresult synced = cuda_driver().CtxSynchronize();
+                inkling_cuda_release_external(add - consumed);
+                for (size_t i = 0; i < tensors.size(); ++i) {
+                    unmap_down(tensors[i], old[i]);
+                }
+                vmm_check(synced, "cuCtxSynchronize during KV rollback");
+            };
+            try {
+                IK_CU(cuda_driver().CtxSynchronize());
+                for (auto & t : tensors) {
+                    const size_t target = goal(t);
+                    while (t.live < target) {
+                        const size_t end =
+                            t.live == 0 ? std::min(page, t.max) : std::min(t.max, (t.live / chunk + 1) * chunk);
+                        const size_t bytes = end - t.live;
+                        map_one(va + t.offset + t.live, bytes);
+                        consumed += bytes;
+                        t.live = end;
+                        live += bytes;
+                    }
+                }
+                IK_CU(cuda_driver().CtxSynchronize());
+            } catch (const vmm_physical_oom &) {
+                rollback();
+                if (reclaim_once()) {
+                    continue;
+                }
+                throw;
+            } catch (...) {
+                rollback();
+                throw;
+            }
+            break;
+        }
+        if (shrink) {
+            for (auto & t : tensors) {
+                unmap_down(t, goal(t));
+            }
+        }
+        std::fprintf(stderr, "Inkling elastic KV: rows=%u committed=%zu MiB reserved=%zu MiB\n", rows, live >> 20,
+                     reserved >> 20);
+    }
+
+    std::pair<tensor_pages *, size_t> range(const ggml_tensor * t, size_t at, size_t n) {
+        auto p = reinterpret_cast<uintptr_t>(t->data) + at;
+        for (auto & a : tensors) {
+            auto start = va + a.offset;
+            if (p >= start && p - start <= ggml_nbytes(a.t) && n <= ggml_nbytes(a.t) - (p - start)) {
+                return { &a, p - start };
+            }
+        }
+        throw std::runtime_error("Inkling elastic KV copy outside tensor");
+    }
+
+    void check_range(const ggml_tensor * t, size_t at, size_t n) {
+        auto [p, off] = range(t, at, n);
+        if (off > p->live || n > p->live - off) {
+            throw std::runtime_error("Inkling elastic KV state IO outside committed prefix");
+        }
+    }
+};
+
+// The server serializes model decode and state commands on one worker.
+kv_mapping * active = nullptr;
+
+void free_kv(ggml_backend_buffer_t b) {
+    auto * m = static_cast<kv_mapping *>(b->context);
+    if (active == m) {
+        active = nullptr;
+    }
+    delete m;
+}
+
+void * base_kv(ggml_backend_buffer_t b) {
+    return reinterpret_cast<void *>(static_cast<kv_mapping *>(b->context)->va);
+}
+
+void set_kv(ggml_backend_buffer_t b, ggml_tensor * t, const void * d, size_t o, size_t n) {
+    auto & m            = *static_cast<kv_mapping *>(b->context);
+    auto [bank, offset] = m.range(t, o, n);
+    const size_t backed = offset < bank->live ? std::min(n, bank->live - offset) : 0;
+    if (backed < n) {
+        // Failed state restore cleanup writes zeros even to still-unmapped cells.
+        const auto * bytes = static_cast<const uint8_t *>(d);
+        if (std::any_of(bytes + backed, bytes + n, [](uint8_t v) { return v != 0; })) {
+            throw std::runtime_error("Inkling elastic KV write outside committed prefix");
+        }
+        n = backed;
+    }
+    if (!n) {
+        return;
+    }
+    scoped_cuda_context current(m.ctx);
+    IK_CU(cuda_driver().MemcpyHtoD(reinterpret_cast<CUdeviceptr>(t->data) + o, d, n));
+}
+
+void get_kv(ggml_backend_buffer_t b, const ggml_tensor * t, void * d, size_t o, size_t n) {
+    auto & m            = *static_cast<kv_mapping *>(b->context);
+    auto [bank, offset] = m.range(t, o, n);
+    const size_t backed = offset < bank->live ? std::min(n, bank->live - offset) : 0;
+    if (backed) {
+        scoped_cuda_context current(m.ctx);
+        IK_CU(cuda_driver().MemcpyDtoH(d, reinterpret_cast<CUdeviceptr>(t->data) + o, backed));
+    }
+    if (backed < n) {
+        std::memset(static_cast<uint8_t *>(d) + backed, 0, n - backed);
+    }
+}
+
+void fill_kv(ggml_backend_buffer_t b, ggml_tensor * t, uint8_t value, size_t off, size_t n) {
+    auto & m    = *static_cast<kv_mapping *>(b->context);
+    auto [p, o] = m.range(t, off, n);
+    if (!value) {
+        n = o < p->live ? std::min(n, p->live - o) : 0;
+    }
+    if (!n) {
+        return;
+    }
+    m.check_range(t, off, n);
+    scoped_cuda_context current(m.ctx);
+    IK_CU(cuda_driver().MemsetD8(reinterpret_cast<CUdeviceptr>(t->data) + off, value, n));
+    IK_CU(cuda_driver().CtxSynchronize());
+}
+
+void clear_kv(ggml_backend_buffer_t b, uint8_t value) {
+    if (value) {
+        throw std::runtime_error("Inkling elastic KV only supports zero clear");
+    }
+    static_cast<kv_mapping *>(b->context)->resize(0, true);
+}
+}  // namespace
+
+bool inkling_kv_vmm_available(bool tested_arch_only) {
+    CUdevice device;
+    int      supported = 0, major = 0, minor = 0;
+    return cuda_driver().ready && cuda_driver().Init(0) == CUDA_SUCCESS &&
+           cuda_driver().DeviceGet(&device, 0) == CUDA_SUCCESS &&
+           cuda_driver().DeviceGetAttribute(&supported, CU_DEVICE_ATTRIBUTE_VIRTUAL_MEMORY_MANAGEMENT_SUPPORTED,
+                                            device) == CUDA_SUCCESS &&
+           supported &&
+           (!tested_arch_only || (cuda_driver().DeviceGetAttribute(&major, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR,
+                                                                   device) == CUDA_SUCCESS &&
+                                  cuda_driver().DeviceGetAttribute(&minor, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR,
+                                                                   device) == CUDA_SUCCESS &&
+                                  major == 12 && minor == 0));
+}
+
+ggml_backend_buffer_t inkling_kv_vmm_alloc(llama_kv_cache *           owner,
+                                           ggml_context *             gg,
+                                           ggml_backend_buffer_type_t buft,
+                                           uint32_t                   cells) {
+    if (active) {
+        throw std::runtime_error("Inkling elastic KV supports a single CUDA0 context");
+    }
+    auto m = std::make_unique<kv_mapping>(owner, cells);
+    if (!m->setup(gg)) {
+        return nullptr;  // No tensor has been bound. The caller can use its ordinary buffer.
+    }
+    ggml_backend_buffer_i iface{};
+    iface.free_buffer   = free_kv;
+    iface.get_base      = base_kv;
+    iface.set_tensor    = set_kv;
+    iface.get_tensor    = get_kv;
+    iface.memset_tensor = fill_kv;
+    iface.clear         = clear_kv;
+    ggml_backend_buffer_ptr buf(ggml_backend_buffer_init(buft, iface, m.get(), m->reserved));
+    auto *                  mapping = m.release();  // buffer now owns the mapping
+    for (auto & tensor : mapping->tensors) {
+        if (ggml_backend_tensor_alloc(buf.get(), tensor.t, reinterpret_cast<void *>(mapping->va + tensor.offset)) !=
+            GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("Inkling elastic KV tensor binding failed");
+        }
+    }
+    for (auto * t = ggml_get_first_tensor(gg); t; t = ggml_get_next_tensor(gg, t)) {
+        if (t->view_src && ggml_backend_view_init(t) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("Inkling elastic KV view binding failed");
+        }
+    }
+    active = mapping;
+    std::fprintf(stderr, "Inkling elastic KV: reserved=%zu MiB, %zu FP16 tensors, page=%zu KiB chunk=%zu KiB\n",
+                 active->reserved >> 20, active->tensors.size(), active->page >> 10, active->chunk >> 10);
+    return buf.release();
+}
+
+bool inkling_kv_vmm_matches(const llama_kv_cache * owner) {
+    return active && active->owner == owner;
+}
+
+void inkling_kv_vmm_rows(const llama_kv_cache * owner, uint32_t cells, bool shrink) {
+    if (inkling_kv_vmm_matches(owner)) {
+        active->resize(cells, shrink);
+    }
+}
+
+bool inkling_kv_vmm_covers(const llama_kv_cache * owner, uint32_t rows) {
+    if (!inkling_kv_vmm_matches(owner)) {
+        return true;
+    }
+    for (auto & t : active->tensors) {
+        if (size_t(rows) * t.t->nb[1] > t.live) {
+            return false;
+        }
+    }
+    return true;
+}
+
+size_t inkling_kv_vmm_unbacked() {
+    return active ? active->reserved - active->live : 0;
+}
+
+void inkling_kv_vmm_reclaim(const void * owner, std::function<void()> cb) {
+    if (active && (cb || active->reclaim_owner == owner)) {
+        active->reclaim_owner = cb ? owner : nullptr;
+        active->reclaim       = std::move(cb);
+    }
+}
+
+#else
+bool inkling_kv_vmm_available(bool) {
+    return false;
+}
+
+ggml_backend_buffer_t inkling_kv_vmm_alloc(llama_kv_cache *, ggml_context *, ggml_backend_buffer_type_t, uint32_t) {
+    throw std::runtime_error("requested elastic KV needs a runtime built with LLAMA_INKLING_VMM=ON");
+}
+
+bool inkling_kv_vmm_matches(const llama_kv_cache *) {
+    return false;
+}
+
+bool inkling_kv_vmm_covers(const llama_kv_cache *, uint32_t) {
+    return true;
+}
+
+void inkling_kv_vmm_rows(const llama_kv_cache *, uint32_t, bool) {}
+
+size_t inkling_kv_vmm_unbacked() {
+    return 0;
+}
+
+void inkling_kv_vmm_reclaim(const void *, std::function<void()>) {}
+#endif
