+static size_t inkling_cache_limit_bytes(const char * name) {
+    const char * value = std::getenv(name);
+    if (!value) {
+        return 0;
+    }
+    char * end = nullptr;
+    const long mib = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || mib < 0 || mib > 16384 ||
+            static_cast<unsigned long>(mib) > (std::numeric_limits<size_t>::max() >> 20)) {
+        throw std::runtime_error(std::string(name) + " must be an integer from 0 to 16384");
+    }
+    return static_cast<size_t>(mib) << 20;
