 static cuda_buffer_budget & buffer_budget() {
     static cuda_buffer_budget budget;
     return budget;
+}
+
+size_t inkling_cuda_budget_available(void) {
+    auto & budget = buffer_budget();
+    std::lock_guard<std::mutex> lock(budget.mutex);
+    return budget.limit > budget.live ? budget.limit - budget.live : 0;
