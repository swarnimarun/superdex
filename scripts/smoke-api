#!/usr/bin/env python3
"""Integration checks for an already running server. Set INKLING_PORT to override 11434."""
import json
import os
import secrets
import urllib.request

base = "http://127.0.0.1:" + os.environ.get("INKLING_PORT", "11434")
model = "inkling-2-mini:latest"


def call(path, payload=None, stream=False):
    body = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(base + path, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=300) as r:
        if stream:
            return [json.loads(line) for line in r if line.strip()]
        return json.load(r)


assert model in [m["name"] for m in call("/api/tags")["models"]]
assert "tools" in call("/api/show", {"model": model})["capabilities"]
assert model in [m["id"] for m in call("/v1/models")["data"]]
prompt = "What is seven times eight? Reply with the number."
for chat, stream in [(False, False), (True, True)]:
    msg = {"messages": [{"role": "user", "content": prompt}]} if chat else {"prompt": prompt}
    result = call("/api/chat" if chat else "/api/generate", {
        "model": model, "stream": stream, "options": {"temperature": 0, "num_predict": 256}, **msg}, stream)
    rows = result if stream else [result]
    assert rows[-1]["done"] and rows[-1]["eval_count"] > 0, rows[-1]
    text = "".join(r["message"]["content"] if chat else r["response"] for r in rows)
    assert "56" in text, text
tools = [{"type": "function", "function": {
    "name": "read_value", "description": "Return the current value for the supplied key.",
    "parameters": {"type": "object", "properties": {"key": {"type": "string"}}, "required": ["key"]},
}}]
messages = [{"role": "user", "content": "Call read_value with key sample. Reply with the value returned."}]
payload = {"model": model, "messages": messages, "tools": tools, "stream": False,
           "options": {"temperature": 0, "num_predict": 256}}
assistant = call("/api/chat", payload)["message"]
tool = assistant["tool_calls"][0]["function"]
assert tool["name"] == "read_value" and tool["arguments"] == {"key": "sample"}, tool
value = secrets.token_hex(8)
messages.extend([assistant, {"role": "tool", "tool_name": tool["name"], "content": value}])
answer = call("/api/chat", payload)["message"]["content"]
assert value in answer, answer
print("Passed discovery, OpenAI model listing, Ollama generate, streaming chat and native tool round trip.")
