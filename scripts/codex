#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
source "$repo/scripts/env.sh"
context=$(python3 "$repo/scripts/client_config.py" codex)
exec codex --no-daemon -c 'model_provider="superdex"' -c "model_catalog_json=\"$repo/.runtime/codex-models-$context.json\"" -c 'web_search="disabled"' \
    -c "model_providers.superdex={name=\"Superdex\",base_url=\"$INKLING_BASE_URL\",wire_api=\"responses\",requires_openai_auth=false}" \
    -c "model_context_window=$context" -m "$INKLING_MODEL" "$@"
