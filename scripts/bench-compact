#!/usr/bin/env python3
"""Run cold retrieval and code trials serially against the already-running local model."""
import argparse
import json
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--retrieval-tokens", nargs="*", type=int, default=[20480, 65536, 131008],
                        help="cold archive prompt lengths; omit values to skip")
    parser.add_argument("--code-tokens", nargs="*", type=int, default=[20480],
                        help="cold code prompt lengths; omit values to skip")
    parser.add_argument("--seed", type=int, default=23591, help="archive seed")
    a = parser.parse_args()
    if not (a.retrieval_tokens or a.code_tokens) or any(n < 1 for n in a.retrieval_tokens + a.code_tokens):
        parser.error("Supply at least one positive prompt length")
    scripts = Path(__file__).resolve().parent
    # Flush one JSON line per completed trial. Earlier results survive a partial run.
    for kind, sizes in (("retrieval", a.retrieval_tokens), ("code", a.code_tokens)):
        for size in sizes:
            cmd = ([str(scripts / "probe-context"), "--seed", str(a.seed)] if kind == "retrieval"
                   else [str(scripts / "bench-code-context")])
            trial = subprocess.run([*cmd, "--tokens", str(size)], stdout=subprocess.PIPE, text=True)
            if trial.stdout:
                result = json.loads(trial.stdout)
                print(json.dumps({"kind": kind, "result": result}), flush=True)
                t = result["timings"]
                if t["cache_n"] != 0 or t["prompt_n"] != size:
                    parser.exit(1, f"Unexpected cold prompt count at {size} tokens: {t}\n")
            if trial.returncode:
                return trial.returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())
