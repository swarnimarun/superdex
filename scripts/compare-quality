#!/usr/bin/env python3
"""Run or compare a paired, single-token multiple-choice evaluation on a native llama-server port."""
import argparse
from datetime import datetime, timezone
from hashlib import sha256
import json
import math
import os
from pathlib import Path
import random
import statistics
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen
from uuid import uuid4


# Each row lists the question, the keyed answer, then three distractors.
# Correct positions are shuffled and balanced independently in each section.
