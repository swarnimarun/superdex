LETTERS = "ABCD"
PREFIX = "My answer is"
METHOD = "inkling-forced-options-v1"


def digest(value):
    return sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def items():
    rng = random.Random(187642)
    for section, bank in BANK.items():
        key_positions = [0, 1, 2, 3] * (len(bank) // 4)
        rng.shuffle(key_positions)
        for i, ((question, key, *other), pos) in enumerate(zip(bank, key_positions)):
            rng.shuffle(other)
            other.insert(pos, key)
            yield {"id": f"{section}-{i + 1:02}", "section": section, "question": question,
                   "options": other, "key": LETTERS[pos]}


def call(base, path, payload=None):
    data = None if payload is None else json.dumps(payload).encode()
    req = Request(base + path, data=data, headers={"Content-Type": "application/json"})
    with urlopen(req, timeout=180) as response:
        return json.load(response)


def answer_tokens(base):
    token_letters = {}
    for letter in LETTERS:
        for form in [letter, " " + letter]:
            ids = call(base, "/tokenize", {"content": form, "add_special": False})["tokens"]
            if len(ids) == 1:
                if ids[0] in token_letters and token_letters[ids[0]] != letter:
                    raise ValueError("Tokenizer mapped different answer options to one ID")
                token_letters[ids[0]] = letter
    if set(token_letters.values()) != set(LETTERS):
        raise ValueError("Tokenizer cannot represent all four answer letters as single tokens")
    return token_letters


def score_item(base, row, tokens):
    options = "\n".join(f"{letter}. {text}" for letter, text in zip(LETTERS, row["options"]))
    user = row["question"] + "\n" + options + "\nChoose the correct option. Answer with its letter only."
    messages = [{"role": "user", "content": user}, {"role": "assistant", "content": PREFIX}]
    prompt = call(base, "/apply-template", {"messages": messages, "add_generation_prompt": False,
                                            "continue_final_message": "content"})["prompt"]
    if not prompt.endswith("<|message_model|><|content_text|>" + PREFIX):
        raise ValueError("Chat template did not produce the intended Inkling assistant text continuation: " + repr(prompt[-160:]))
    # Give every candidate the same additive bias so even low-likelihood options
    # are returned in top_probs. Conditioning on these candidates cancels the bias.
    result = call(base, "/completion", {"prompt": prompt, "n_predict": 1, "temperature": 1,
                  "samplers": ["temperature"], "top_k": 0, "top_p": 1, "min_p": 0, "seed": 73,
                  "cache_prompt": False, "n_probs": len(tokens) + 4, "post_sampling_probs": True,
                  "logit_bias": [[tid, 80.0] for tid in sorted(tokens)]})
    candidates = result["completion_probabilities"][0]["top_probs"]
    found = {p["id"]: p["prob"] for p in candidates if p["id"] in tokens}
    if set(found) != set(tokens) or any(not math.isfinite(p) or p <= 0 for p in found.values()):
        raise ValueError(f"Incomplete option probabilities on {row['id']}: {candidates}")
    probs = {l: sum(found[t] for t in tokens if tokens[t] == l) / sum(found.values()) for l in LETTERS}
    prediction = max(LETTERS, key=probs.get)
    return {**row, "prompt_sha256": digest(prompt), "choice_probabilities": probs, "prediction": prediction,
            "correct": prediction == row["key"], "gold_nll": -math.log(probs[row["key"]])}


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(path.name + ".tmp")
    temp.write_text(json.dumps(value, indent=2) + "\n")
    temp.replace(path)


def run(args):
    base = "http://127.0.0.1:" + str(args.port)
    props = call(base, "/props")
    tokens = answer_tokens(base)
    questions = list(items())
    result = {"method": METHOD, "suite_sha256": digest(questions), "run_id": str(uuid4()),
              "started_utc": datetime.now(timezone.utc).isoformat(), "label": args.label,
              "model_path": props["model_path"], "build_info": props.get("build_info"),
              "token_letters": tokens, "complete": False, "items": []}
    for row in questions:
        result["items"].append(score_item(base, row, tokens))
        result["complete"] = len(result["items"]) == len(questions)
        write_json(args.output, result)
    print(json.dumps({"label": args.label, "model_path": result["model_path"], "n": len(questions),
                      "accuracy": statistics.mean(i["correct"] for i in result["items"]),
                      "mean_gold_nll": statistics.mean(i["gold_nll"] for i in result["items"]),
                      "output": str(args.output)}))


def binomial_cdf(k, n, p):
    return sum(math.comb(n, j) * p**j * (1-p)**(n-j) for j in range(k + 1))


def proportion_bounds(k, n):
    # Bonferroni: four one-sided binomial tails for paired gains and losses.
    tail = 0.05 / 4
    def solve(index, target):
        lo, hi = 0.0, 1.0
        for _ in range(60):
            mid = (lo + hi) / 2
            if binomial_cdf(index, n, mid) > target:
                lo = mid
            else:
                hi = mid
        return (lo + hi) / 2
    return (solve(k - 1, 1-tail) if k else 0, solve(k, tail) if k < n else 1)


def paired(reference, candidate):
    if not all(x["complete"] and x["method"] == METHOD and x["suite_sha256"] == digest(list(items()))
               for x in (reference, candidate)):
        raise ValueError("Incomplete or incompatible results; score the same suite with both backends")
    if reference["token_letters"] != candidate["token_letters"] or reference["run_id"] == candidate["run_id"]:
        raise ValueError("Comparisons require independent runs with matching answer tokenization")
    rows = list(zip(reference["items"], candidate["items"]))
    if len(reference["items"]) != len(candidate["items"]) or len(rows) != len(list(items())):
        raise ValueError("Missing paired items")
    for (a, b), item in zip(rows, items()):
        if a["id"] != item["id"] or b["id"] != item["id"] or a["prompt_sha256"] != b["prompt_sha256"]:
            raise ValueError("Question order or rendered input differs at " + item["id"])
    gains = sum(b["correct"] and not a["correct"] for a, b in rows)
    losses = sum(a["correct"] and not b["correct"] for a, b in rows)
    n = len(rows)
    gl, gu = proportion_bounds(gains, n)
    ll, lu = proportion_bounds(losses, n)
    changes = [b["gold_nll"] - a["gold_nll"] for a, b in rows]
    rng = random.Random(36483)
    boot = sorted(statistics.mean(rng.choices(changes, k=n)) for _ in range(2000))
    discordant = gains + losses
    mcnemar = min(1, 2 * binomial_cdf(min(gains, losses), discordant, .5))
    return {"n": n, "reference_label": reference["label"], "candidate_label": candidate["label"],
            "reference_accuracy": statistics.mean(a["correct"] for a, _ in rows),
            "candidate_accuracy": statistics.mean(b["correct"] for _, b in rows),
            "accuracy_delta_pp": 100*(gains-losses)/n,
            "accuracy_delta_95pct_conservative_pp": [100*(gl-lu), 100*(gu-ll)],
            "gains": gains, "losses": losses, "mcnemar_exact_p": mcnemar,
            "choice_changes": [a["id"] for a,b in rows if a["prediction"] != b["prediction"]],
            "reference_mean_gold_nll": statistics.mean(a["gold_nll"] for a, _ in rows),
            "candidate_mean_gold_nll": statistics.mean(b["gold_nll"] for _, b in rows),
            "mean_gold_nll_delta_nats": statistics.mean(changes),
            "mean_gold_nll_delta_95pct_bootstrap_nats": [boot[49], boot[1949]],
            "accuracy_by_domain": {domain: {"reference": statistics.mean(a["correct"] for a, _ in rows if a["section"] == domain),
                                            "candidate": statistics.mean(b["correct"] for _, b in rows if b["section"] == domain)}
                                   for domain in BANK}}


def compare(args):
    reference = json.loads(args.reference.read_text())
    result = {"candidate_vs_reference": paired(reference, json.loads(args.candidate.read_text())),
              "limitations": "Intervals use the 48 authored questions as independent observations. Scores apply to single-token forced choices on this fixed suite; they do not establish general model equivalence. Lower gold NLL is better."}
    if args.repeat_reference:
        repeat = json.loads(args.repeat_reference.read_text())
        if repeat["model_path"] != reference["model_path"]:
            raise ValueError("Repeat reference must use the same reference checkpoint path")
        result["reference_repeat_vs_reference"] = paired(reference, repeat)
    print(json.dumps(result, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    run_parser = sub.add_parser("run", help="Score the native backend currently bound to the selected port")
    run_parser.add_argument("--port", type=int, default=int(os.environ.get("INKLING_BACKEND_PORT", "18567")))
    run_parser.add_argument("--label", required=True)
    run_parser.add_argument("--output", required=True, type=Path)
    comp_parser = sub.add_parser("compare", help="Compare paired scores from saved runs")
    comp_parser.add_argument("reference", type=Path)
    comp_parser.add_argument("candidate", type=Path)
    comp_parser.add_argument("--repeat-reference", type=Path)
    args = parser.parse_args()
    (run if args.action == "run" else compare)(args)


if __name__ == "__main__":
    try:
        main()
    except HTTPError as exc:
        sys.exit(f"HTTP {exc.code}: {exc.read(1000).decode(errors='replace')}")
    except (OSError, URLError, ValueError, KeyError, IndexError) as exc:
        sys.exit(str(exc))
