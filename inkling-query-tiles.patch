+        }
+        char * end = nullptr;
+        const long long parsed = std::strtoll(value, &end, 10);
+        if (end == value || *end || parsed < 0 || parsed > INT32_MAX) {
+            throw std::invalid_argument("INKLING_QUERY_TILE_CELLS must be an integer from 0 to 2147483647");
