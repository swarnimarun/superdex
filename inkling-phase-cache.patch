+// Destroy all graphs referring to the old scheduler before dropping its high-water buffers.
+void llama_context::phase_cache_clear_compute() {
+    ggml_backend_sched_synchronize(sched.get());
+    gf_res_prev_active = nullptr;
+    for (auto & res : gf_res_prev) res->reset();
+    gf_res_reserve->reset();
+    copy_experts.reset();
+    const auto params = sched_params_cur;
+    sched.reset();
+    sched_new(params);
+}
+
+void llama_context::phase_cache_restore() {
+    phase_cache_clear_compute();
+    moe_cache.reset();
+    moe_cache = std::make_unique<llama_moe_cache>(model, false, backend_ptrs, backend_buft,
+                                                 cparams.moe_cache_size, cparams.moe_cache_cpu_share);
+    phase_cache_decode = false;
+    phase_cache_streak = 0;
+    LLAMA_LOG_INFO("Inkling phase cache: restored prefill expert cache request %.1f MiB\n",
+                   cparams.moe_cache_size/1048576.0);
+}
+
+void llama_context::phase_cache_enter() {
+    // Both cache maps use exact copies of model weights; only expert residency changes.
+    auto * device = backend_ptrs[phase_cache_gpu];
+    auto * buft = backend_buft[phase_cache_gpu];
+    const size_t prefill_scratch = ggml_backend_sched_get_buffer_size(sched.get(), device);
+    const size_t old_cache = moe_cache->memory_breakdown().at(buft);
+    const size_t envelope = prefill_scratch + old_cache;
+    const size_t guard = 128ull << 20;
+    constexpr double mib = 1048576.0;
+    bool replaced_cache = false;
+    try {
+        auto full = memory->init_full();
+        if (!full) throw std::runtime_error("full context view unavailable");
+        phase_cache_clear_compute();
+        std::vector<size_t> sizes(backend_ptrs.size());
+        if (!graph_reserve(1, 1, 1, full.get(), true, sizes.data())) {
+            throw std::runtime_error("cannot size one-token full-context graph");
+        }
+        const size_t decode_scratch = sizes[phase_cache_gpu];
+        if (prefill_scratch <= decode_scratch + guard) {
+            throw std::runtime_error("insufficient reusable prefill scratch");
+        }
+        const size_t extra = std::min(phase_cache_extra, prefill_scratch - decode_scratch - guard);
+        const size_t requested = old_cache + extra;
+        // No prefill backing buffers or expert replicas overlap the new allocation.
+        phase_cache_clear_compute();
+        moe_cache.reset();
+        replaced_cache = true;
+        moe_cache = std::make_unique<llama_moe_cache>(model, false, backend_ptrs, backend_buft,
+                                                     requested, cparams.moe_cache_cpu_share);
+        const size_t actual_cache = moe_cache->memory_breakdown().at(buft);
+        if (!graph_reserve(1, 1, 1, full.get(), true, sizes.data()) ||
+            sizes[phase_cache_gpu] + actual_cache + guard > envelope) {
+            throw std::runtime_error("enlarged cache and one-token graph exceed prefill envelope");
+        }
+        if (!graph_reserve(1, 1, 1, full.get()) ||
+            ggml_backend_sched_get_buffer_size(sched.get(), device) + actual_cache > envelope) {
+            throw std::runtime_error("could not reserve one-token full-context workspace");
+        }
+        for (size_t i=0; i<backend_ptrs.size(); ++i) {
+            backend_buf_exp_size[i]=ggml_backend_sched_get_buffer_size(sched.get(), backend_ptrs[i]);
+        }
+        phase_cache_decode = true;
+        LLAMA_LOG_INFO("Inkling phase cache: decode active, prefill scratch %.1f MiB, decode scratch %.1f MiB, "
+                       "expert cache %.1f -> %.1f MiB, shared ceiling %.1f MiB\n",
+                       prefill_scratch/mib,backend_buf_exp_size[phase_cache_gpu]/mib,old_cache/mib,actual_cache/mib,envelope/mib);
+    } catch (const std::exception & e) {
+        LLAMA_LOG_WARN("Inkling phase cache: disabling after %s\n", e.what());
+        phase_cache_extra = 0;
+        if (replaced_cache) phase_cache_restore();
+        sched_need_reserve = true;
+        sched_reserve();
+    }
+}
