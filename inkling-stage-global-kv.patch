+static ggml_backend_t inkling_attention_backend(const llm_graph_context & gctx, int il) {
+    if (!inkling_host_global_kv(gctx.model, il)) {
+        return nullptr;
+    }
+    if (!gctx.cparams.flash_attn || !inkling_stage_global_kv()) {
+        return gctx.backend_cpu;
+    }
+    auto * device = gctx.model.dev_layer(il);
+    for (int i = 0; i < ggml_backend_sched_get_n_backends(gctx.sched); ++i) {
+        auto * backend = ggml_backend_sched_get_backend(gctx.sched, i);
+        if (ggml_backend_get_device(backend) == device) {
+            return backend;
+        }
+    }
+    throw std::runtime_error("Inkling global KV attention device is missing from the scheduler");
+}
