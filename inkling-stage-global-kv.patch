+// Keep selected cache banks on the host and transfer just their active prefix for GPU attention.
+inline bool inkling_stage_global_kv() {
+    static const bool enabled = []() {
+        const char * value = std::getenv("INKLING_STAGE_GLOBAL_KV");
+        if (!value || !*value || (value[0] == '0' && !value[1])) {
+            return false;
+        }
+        if (value[0] != '1' || value[1]) {
+            throw std::invalid_argument("INKLING_STAGE_GLOBAL_KV must be 0 or 1");
+        }
+        return true;
+    }();
+    return enabled;
+}
