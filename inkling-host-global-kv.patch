--- /dev/null
+++ b/src/inkling-host-global-kv.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "llama-model.h"
+
+#include <cstdlib>
+#include <stdexcept>
+
+// Repeated passes have distinct logical KV layers. Select the first N global
+// caches in allocation order, independently of the model's expert weight device.
+inline bool inkling_host_global_kv(const llama_model & model, int il) {
+    static const int count = []() -> int {
+        const char * value = std::getenv("INKLING_HOST_GLOBAL_KV");
+        if (!value || !*value) {
+            return 0;
+        }
+        if (value[0] < '0' || value[0] > '8' || value[1]) {
+            throw std::invalid_argument("INKLING_HOST_GLOBAL_KV must be an integer from 0 to 8");
+        }
+        return value[0] - '0';
+    }();
+    const auto & hp = model.hparams;
+    if (!count || model.arch != LLM_ARCH_INKLING2_LOOP || il < 0 || !hp.has_kv(il) || hp.is_swa(il)) {
+        return false;
+    }
+    int remaining = count;
+    for (int layer = 0; layer < il; ++layer) {
+        if (hp.has_kv(layer) && !hp.is_swa(layer) && --remaining == 0) {
+            return false;
+        }
+    }
+    return true;
+}
