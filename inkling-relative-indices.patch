+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+inline bool inkling_rel_flag(const char * name) {
+    const char * s = std::getenv(name);
+    if (!s || !*s || (s[0] == '0' && !s[1])) {
+        return false;
+    }
+    if (s[0] != '1' || s[1]) {
+        throw std::invalid_argument(std::string(name) + " must be 0 or 1");
+    }
+    return true;
+}
+
+// For every query in this sequence, remote valid keys share the last learned
+// bucket and blocked keys share a separate -infinity bucket in packed mode.
+template<class ReadKey>
+void inkling_relative_indices(int32_t * data, uint32_t n_kv, int32_t extent, bool packed,
+        const std::vector<std::pair<uint32_t, int32_t>> & queries, ReadKey read_key) {
+    if (queries.empty()) {
+        return;
+    }
+    const int32_t blocked = packed ? extent + 1 : extent;
+    auto bucket = [=](int32_t query, int32_t key) {
+        if (key < 0 || key > query) {
+            return blocked;
+        }
+        return int32_t(std::min<int64_t>(extent, int64_t(query) - key));
+    };
+    if (queries.size() == 1) {
+        const auto [row, query] = queries.front();
+        auto * dst = data + size_t(row) * n_kv;
+        for (uint32_t j = 0; j < n_kv; ++j) {
+            dst[j] = bucket(query, read_key(j));
+        }
+        return;
+    }
+    int32_t low = std::numeric_limits<int32_t>::max();
+    int32_t high = std::numeric_limits<int32_t>::min();
+    for (const auto & row : queries) {
+        low = std::min(low, row.second);
+        high = std::max(high, row.second);
+    }
+    std::vector<int32_t> background(n_kv, blocked);
+    std::vector<std::pair<uint32_t, int32_t>> recent;
+    for (uint32_t j = 0; j < n_kv; ++j) {
+        const int32_t key = read_key(j);
+        if (key < 0 || key > high) {
+            continue;
+        }
+        if (key <= int64_t(low) - extent) {
+            background[j] = extent;
+        } else {
+            recent.emplace_back(j, key);
+        }
+    }
+    for (const auto [row, query] : queries) {
+        int32_t * dst = data + size_t(row) * n_kv;
+        std::copy(background.begin(), background.end(), dst);
+        for (const auto [j, key] : recent) {
+            dst[j] = bucket(query, key);
+        }
+    }
+}
